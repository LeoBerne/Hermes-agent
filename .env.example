# ==============================================================
# Hermes Agent - Configurações de Ambiente (TEMPLATE)
# ==============================================================
# Copie este arquivo para .env e preencha com suas chaves reais:
# cp .env.example .env

# --- OpenRouter (Provedor LLM) ---
# Sua chave de API obtida em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Modelo padrão recomendado com excelente suporte a tool calling e raciocínio:
# Opção Recomendada: anthropic/claude-3.5-sonnet
# Opção Nous Research: nousresearch/hermes-3-llama-3.1-405b
# Opção Custo-Benefício: deepseek/deepseek-chat
HERMES_MODEL=anthropic/claude-3.5-sonnet
HERMES_PROVIDER=openrouter

# --- Telegram Gateway ---
# Token obtido com o @BotFather no Telegram (ex: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui

# IDs numéricos dos usuários autorizados a interagir com o bot (separados por vírgula).
# IMPORTANTE PARA SEGURANÇA: Impede que terceiros acessem seu agente e gastem sua cota.
# Para descobrir seu ID, envie uma mensagem no Telegram para @userinfobot ou @raw_data_bot
TELEGRAM_ALLOWED_USERS=123456789

# --- Diretório e Permissões do Hermes ---
HERMES_HOME=/opt/data
